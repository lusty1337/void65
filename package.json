{
  "name": "void65-premium-keyboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Процедурная 3D-модель премиальной механической клавиатуры VOID65 на React Three Fiber",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verify": "node scripts/verify.mjs",
    "assets:hdri": "node scripts/fetchHdri.mjs",
    "assets:keycaps": "node scripts/genKeycaps.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.19.1",
    "postprocessing": "6.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "puppeteer-core": "^25.5.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
